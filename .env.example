# Copy this file to `.env` and fill in the values.

# PostgreSQL connection string (e.g. from Neon, Supabase or Vercel Postgres).
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js session secret. Generate one with:  npx auth secret
# (or:  openssl rand -base64 32)
AUTH_SECRET="replace-with-a-generated-secret"
AUTH_TRUST_HOST=true
